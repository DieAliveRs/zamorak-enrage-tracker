---
interface Props {
  topPlayers: any[];
  uniquePlayersCount: number;
  killData: any;
}

const { topPlayers, uniquePlayersCount, killData } = Astro.props;

const lastUpdateTimestamp = (() => {
  if (!killData.meta.generated_at) return null;
  
  if (typeof killData.meta.generated_at === 'number') {
    return killData.meta.generated_at;
  } else if (typeof killData.meta.generated_at === 'string') {
    const date = new Date(killData.meta.generated_at);
    return Math.floor(date.getTime() / 1000);
  }
  return null;
})();

// Server-side helper function
function getRSIconUrl(playerName: string): string | null {
  if (!playerName || playerName === 'Unknown') {
    return null;
  }
  
  const encodedName = encodeURIComponent(playerName);
  return `https://secure.runescape.com/m=avatar-rs/${encodedName}/chat.png`;
}

// Prepare data for client script
const scriptData = {
  topPlayers,
  killData,
  lastUpdateTimestamp
};
---

<!-- Ranking Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg dark:shadow-gray-900/30 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-gray-100 to-gray-100 dark:from-gray-800 dark:to-gray-800">
    <div class="flex justify-between items-center">
      <div>
        <h2 class="text-xl font-bold text-gray-800 dark:text-white">Top 15 Players Ranking</h2>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-sm px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">
          {topPlayers.length} players
        </span>
      </div>
    </div>
  </div>
  
  {killData.records.length === 0 ? (
    <div class="p-12 text-center">
      <div class="text-gray-300 dark:text-gray-600 text-6xl mb-4">🏆</div>
      <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">No Player Data Available</h3>
      <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto">
        No kill records found to generate the leaderboard.
      </p>
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Rank</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Player</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Highest Enrage</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Kill Time</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Time</th>
          </tr>
        </thead>
        <tbody id="ranking-table-body" class="divide-y divide-gray-200 dark:divide-gray-700">
          {topPlayers.map((record, index) => {
            const playerName = record.playerName || record.members[0]?.name || 'Unknown';
            const enragePercent = record.enrage;
            const killTime = record.killTimeSeconds;
            const killDate = record.timeOfKill;
            const avatarUrl = getRSIconUrl(playerName);
            
            // Determine enrage color
            let enrageClass = 'font-bold ';
            if (enragePercent >= 55000) enrageClass += 'text-[#FF5B5A] dark:text-[#FF5B5A]';
            else if (enragePercent >= 50000) enrageClass += 'text-[#F65B7C] dark:text-[#FF6E5F]';
            else if (enragePercent >= 45000) enrageClass += 'text-[#E665A2] dark:text-[#FF8361]';
            else if (enragePercent >= 40000) enrageClass += 'text-[#D065B8] dark:text-[#FF9A62]';
            else if (enragePercent >= 35000) enrageClass += 'text-[#B06CBC] dark:text-[#FFB369]';
            else if (enragePercent >= 30000) enrageClass += 'text-[#8E6CC0] dark:text-[#FFC870]';
            else if (enragePercent >= 25000) enrageClass += 'text-[#766CC0] dark:text-[#FFD37E]';
            else if (enragePercent >= 20000) enrageClass += 'text-[#6064A7] dark:text-[#FFE396]';
            else if (enragePercent >= 15000) enrageClass += 'text-[#576190] dark:text-[#FFECAC]';
            else if (enragePercent >= 10000) enrageClass += 'text-[#535974] dark:text-[#FFF1C1]';
            else if (enragePercent >= 5000) enrageClass += 'text-[#474D64] dark:text-[#FFF5D1]';
            else if (enragePercent >= 0) enrageClass += 'text-[#474D64] dark:text-[#FFF5D1]';
            
            // Determine rank badge
            let rankBadgeClass = '';
            let rankNumber = index + 1;
            
            if (index === 0) {
              rankBadgeClass = 'bg-gradient-to-r from-yellow-400 to-yellow-500 dark:from-yellow-500 dark:to-yellow-600 text-white text-lg font-bold shadow';
            } else if (index === 1) {
              rankBadgeClass = 'bg-gradient-to-r from-gray-300 to-gray-400 dark:from-gray-500 dark:to-gray-600 text-white text-lg font-bold';
            } else if (index === 2) {
              rankBadgeClass = 'bg-gradient-to-r from-orange-300 to-orange-400 dark:from-orange-500 dark:to-orange-600 text-white text-lg font-bold';
            } else {
              rankBadgeClass = 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300';
            }
            
            // Format kill time
            const killTimeFormatted = (() => {
              const mins = Math.floor(killTime / 60);
              const secs = (killTime % 60).toFixed(1);
              return `${mins}:${secs.padStart(4, '0')}`;
            })();
            
            return (
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <span class={`inline-flex items-center justify-center w-10 h-10 rounded-full ${rankBadgeClass}`}>
                      {rankNumber}
                    </span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center space-x-3">
                    {avatarUrl ? (
                      <img src={avatarUrl} alt={playerName} 
                           class="w-10 h-10 rounded-full border border-gray-300 dark:border-gray-600 flex-shrink-0" />
                    ) : (
                      <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 
                                  flex items-center justify-center text-gray-500 dark:text-gray-400
                                  flex-shrink-0">
                        👤
                      </div>
                    )}
                    <a 
                      href={`${import.meta.env.BASE_URL}personal-progress/?player=${encodeURIComponent(playerName)}`}
                      class="text-lg font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 truncate max-w-[180px] transition-colors duration-150 hover:underline"
                      title={`View ${encodeURIComponent(playerName)}'s detailed stats`}
                    >
                      {playerName}
                    </a>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class={enrageClass + " text-2xl"}>
                    {enragePercent.toLocaleString()}%
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="font-mono font-semibold text-gray-900 dark:text-white text-lg">
                    {killTimeFormatted}
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900 dark:text-gray-300 font-medium" data-timestamp={killDate}>
                    <!-- Will be formatted by JavaScript -->
                  </div>
                  <div class="text-sm font-semibold text-blue-600 dark:text-blue-400" data-timestamp={killDate}>
                    <!-- Will show time ago by JavaScript -->
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
  
  <!-- Table Footer -->
  <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
    <div class="flex justify-between items-center">
      <div class="text-sm text-gray-600 dark:text-gray-400">
        Showing top 15 of {uniquePlayersCount} unique players
      </div>
      <div class="text-sm text-gray-600 dark:text-gray-400" id="data-updated-text">
        {lastUpdateTimestamp ? (
          <span data-timestamp={lastUpdateTimestamp}>
            <!-- Will be formatted by JavaScript -->
          </span>
        ) : (
          'Data updated: Never'
        )}
      </div>
    </div>
  </div>
</div>

<script define:vars={{ scriptData }}>
  // Helper functions (defined inline for browser execution)
  function formatTimestamp(timestamp) {
    const date = new Date(timestamp * 1000);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }
  
  function formatLocalTime(timestamp) {
    const date = new Date(timestamp * 1000);
    return date.toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit'
    });
  }
  
  function formatLocalDate(timestamp) {
    const date = new Date(timestamp * 1000);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }
  
  function timeAgo(timestamp) {
    const now = Math.floor(Date.now() / 1000);
    const secondsAgo = now - timestamp;
    
    if (secondsAgo < 60) return 'Just now';
    
    const hours = Math.floor(secondsAgo / 3600);
    const minutes = Math.floor((secondsAgo % 3600) / 60);
    
    if (hours > 0) {
      if (hours >= 72) {
        const days = Math.floor(hours / 24);
        return `${days}d ago`;
      }
      return `${hours}h ${minutes}m ago`;
    }
    return `${minutes}m ago`;
  }

  function formatTableTimes() {
    const { lastUpdateTimestamp } = scriptData;
    
    // Format the "Data updated" text
    const dataUpdatedElement = document.getElementById('data-updated-text');
    if (dataUpdatedElement && lastUpdateTimestamp) {
      dataUpdatedElement.textContent = `Data updated: ${formatLocalDate(lastUpdateTimestamp)} ${formatLocalTime(lastUpdateTimestamp)}`;
    }
    
    // Format date cells in the table
    document.querySelectorAll('#ranking-table-body [data-timestamp]').forEach(element => {
      const timestamp = parseInt(element.getAttribute('data-timestamp'));
      if (isNaN(timestamp)) return;
      
      if (element.classList.contains('text-sm') && element.classList.contains('font-medium')) {
        // This is the date cell
        if (!element.classList.contains('formatted')) {
          element.textContent = formatTimestamp(timestamp);
          element.classList.add('formatted');
        }
      } else if (element.classList.contains('text-blue-600') || element.classList.contains('dark:text-blue-400')) {
        // This is the time ago cell
        if (!element.classList.contains('formatted')) {
          element.textContent = timeAgo(timestamp);
          element.classList.add('formatted');
        }
      }
    });
  }
  
  // Update time ago cells every minute
  function updateTimeAgo() {
    document.querySelectorAll('#ranking-table-body .text-blue-600.dark\\:text-blue-400[data-timestamp]').forEach(el => {
      if (el.classList.contains('formatted')) {
        const timestamp = parseInt(el.getAttribute('data-timestamp'));
        el.textContent = timeAgo(timestamp);
      }
    });
  }
  
  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      formatTableTimes();
      setInterval(updateTimeAgo, 60000);
    });
  } else {
    formatTableTimes();
    setInterval(updateTimeAgo, 60000);
  }
</script>