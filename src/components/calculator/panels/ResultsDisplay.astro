<script type="module">
  // Tab switching logic - SCOPED to results tabs only
  function switchTab(tabName) {
    console.log('Switching results tab to:', tabName);
    
    // Get the results container
    const container = document.querySelector('.results-tabs-container');
    if (!container) {
      console.warn('Results container not found');
      return;
    }
    
    // Only select elements WITHIN THIS CONTAINER
    const contents = container.querySelectorAll('.tab-content');
    const target = container.querySelector(`#${tabName}-content`);
    const activeTab = container.querySelector(`#${tabName}-tab`);

    // If the tab does not exist, DO NOTHING
    if (!target || !activeTab) {
      console.warn('Invalid results tab:', tabName);
      return;
    }

    // Hide all tab contents IN THIS CONTAINER ONLY
    contents.forEach(content => {
      content.classList.add('hidden');
    });

    // Reset all tab buttons IN THIS CONTAINER ONLY
    container.querySelectorAll('button[id$="-tab"]').forEach(button => {
      button.classList.remove(
        'border-blue-500',
        'text-blue-600',
        'dark:text-blue-400',
        'dark:border-blue-400'
      );
      button.classList.add('border-transparent');
    });

    // Show the target tab content
    target.classList.remove('hidden');

    // Activate the target tab button
    activeTab.classList.remove('border-transparent');
    activeTab.classList.add(
      'border-blue-500',
      'text-blue-600',
      'dark:text-blue-400',
      'dark:border-blue-400'
    );
    
    // Use a unique key for results tabs
    localStorage.setItem('activeResultsTab', tabName);
  }

  function initTabs() {
    console.log('Initializing results tabs...');
    
    // Get the container
    const container = document.querySelector('.results-tabs-container');
    if (!container) {
      console.warn('Results container not found, retrying...');
      setTimeout(initTabs, 100);
      return;
    }
    
    const stored = localStorage.getItem('activeResultsTab');
    const fallback = 'damage';

    console.log('Stored results tab:', stored);
    
    // Check if the stored tab exists IN THIS CONTAINER
    const exists =
      stored &&
      container.querySelector(`#${stored}-tab`) &&
      container.querySelector(`#${stored}-content`);

    if (exists) {
      console.log('Found stored results tab:', stored);
      setTimeout(() => switchTab(stored), 10);
    } else {
      console.log('Using fallback results tab:', fallback);
      setTimeout(() => switchTab(fallback), 10);
    }

    // Add click handlers to buttons IN THIS CONTAINER ONLY
    container.querySelectorAll('button[id$="-tab"]').forEach(button => {
      button.addEventListener('click', (e) => {
        const tabName = e.currentTarget.id.replace('-tab', '');
        console.log('Results tab clicked:', tabName);
        switchTab(tabName);
      });
    });
  }

  // IMPORTANT: handle module timing correctly
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabs);
  } else {
    setTimeout(initTabs, 100);
  }


  // Results update logic
  const set = (id, value) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value ?? '0';
  };

  const fmt = (v) => v != null ? v.toLocaleString() : '0';

  function updateResults(results) {
    if (!results) return;

    // Damage Taken values
    set('mage-damage-min', results.mageAutos?.min?.toLocaleString());
    set('mage-damage-max', results.mageAutos?.max?.toLocaleString());
    set('mage-damage-avg', results.mageAutos?.avg?.toLocaleString());
    set('mage-damage-ts', results.mageAutos?.ts?.toLocaleString());

    set('range-damage-min', results.rangeAutos?.min?.toLocaleString());
    set('range-damage-max', results.rangeAutos?.max?.toLocaleString());
    set('range-damage-avg', results.rangeAutos?.avg?.toLocaleString());
    set('range-damage-ts', results.rangeAutos?.ts?.toLocaleString());

    set('infernus-min', results.infernus?.min?.toLocaleString());
    set('infernus-max', results.infernus?.max?.toLocaleString());
    set('infernus-avg', results.infernus?.avg?.toLocaleString());

    set('slam-primary', results.slam?.primary?.toLocaleString());
    set('slam-secondary', results.slam?.secondary?.toLocaleString());

    set('smoke-damage', results.smoke?.damage?.toLocaleString());
    set('tomb-damage', results.tomb?.damage?.toLocaleString());
    set('decimation-damage', results.decimation?.damage?.toLocaleString());
    set('cage-damage', results.cage?.damage?.toLocaleString());

    set('bigbomb-min', results.bigBomb?.min?.toLocaleString());
    set('bigbomb-max', results.bigBomb?.max?.toLocaleString());
    set('bigbomb-avg', results.bigBomb?.avg?.toLocaleString());

    set('smallbomb-normal', results.smallBomb?.normal?.toLocaleString());
    set('smallbomb-ts', results.smallBomb?.twinshot?.toLocaleString());

    // Healing values
    set('mage-heal-min', results.mageDivert?.min?.toLocaleString());
    set('mage-heal-max', results.mageDivert?.max?.toLocaleString());
    set('mage-heal-avg', results.mageDivert?.avg?.toLocaleString());
    set('mage-heal-ts', results.mageDivert?.ts?.toLocaleString());

    set('range-heal-min', results.rangeDivert?.min?.toLocaleString());
    set('range-heal-max', results.rangeDivert?.max?.toLocaleString());
    set('range-heal-avg', results.rangeDivert?.avg?.toLocaleString());
    set('range-heal-ts', results.rangeDivert?.ts?.toLocaleString());

    set('slam-heal-primary', results.slamDivert?.primary?.toLocaleString());
    set('slam-heal-secondary', results.slamDivert?.secondary?.toLocaleString());

    set('smoke-heal', results.smokeDivert?.toLocaleString());
    set('tomb-heal', results.tombDivert?.toLocaleString());
    set('decimation-heal', results.decimationDivert?.toLocaleString());
    set('cage-heal', results.cageDivert?.toLocaleString());

    set('bigbomb-heal-min', results.bigBombDivert?.min?.toLocaleString());
    set('bigbomb-heal-max', results.bigBombDivert?.max?.toLocaleString());
    set('bigbomb-heal-avg', results.bigBombDivert?.avg?.toLocaleString());

    set('smallbomb-heal-normal', results.smallBombDivert?.normal?.toLocaleString());
    set('smallbomb-heal-ts', results.smallBombDivert?.twinshot?.toLocaleString());

    // Reflect values
    set('mage-refl-min', results.mageReflect?.min?.toLocaleString());
    set('mage-refl-max', results.mageReflect?.max?.toLocaleString());
    set('mage-refl-avg', results.mageReflect?.avg?.toLocaleString());
    set('mage-refl-ts', results.mageReflect?.ts?.toLocaleString());

    set('range-refl-min', results.rangeReflect?.min?.toLocaleString());
    set('range-refl-max', results.rangeReflect?.max?.toLocaleString());
    set('range-refl-avg', results.rangeReflect?.avg?.toLocaleString());
    set('range-refl-ts', results.rangeReflect?.ts?.toLocaleString());

    set('slam-refl-primary', results.slamReflect?.primary?.toLocaleString());
    set('slam-refl-secondary', results.slamReflect?.secondary?.toLocaleString());

    set('smoke-refl', results.smokeReflect?.toLocaleString());
    set('tomb-refl', results.tombReflect?.toLocaleString());
    set('decimation-refl', results.decimationReflect?.toLocaleString());
    set('cage-refl', results.cageReflect?.toLocaleString());

    set('bigbomb-refl-min', results.bigBombReflect?.min?.toLocaleString());
    set('bigbomb-refl-max', results.bigBombReflect?.max?.toLocaleString());
    set('bigbomb-refl-avg', results.bigBombReflect?.avg?.toLocaleString());

    set('smallbomb-refl-normal', results.smallBombReflect?.normal?.toLocaleString());
    set('smallbomb-refl-ts', results.smallBombReflect?.twinshot?.toLocaleString());
  }

  // Listen for results updates
  document.addEventListener(
    'calculator-results-updated',
    (e) => updateResults(e.detail)
  );
</script>

