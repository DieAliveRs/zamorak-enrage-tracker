  // ========== WEEKLY SUMMARY FUNCTIONS ==========
  function initializeWeeklySummary(kills) {
    const weeklySection = document.getElementById('weekly-summary-section');
    if (!weeklySection) return;
    
    weeklySummaryData = calculateWeeklyStats(kills);
    
    if (!weeklySummaryData || weeklySummaryData.length === 0) {
      weeklySection.classList.add('hidden');
      return;
    }
    
    weeklySection.classList.remove('hidden');
    currentWeekIndex = 0;
    populateWeekDropdown();
    updateWeeklyDisplay();
  }

  function populateWeekDropdown() {
    const weekSelect = document.getElementById('week-select');
    if (!weekSelect || !weeklySummaryData) return;
    
    weekSelect.innerHTML = '';
    
    weeklySummaryData.forEach((week, index) => {
      const option = document.createElement('option');
      option.value = index;
      option.textContent = `${week.formattedRange} (${week.killCount} kills)`;
      if (index === 0) option.selected = true;
      weekSelect.appendChild(option);
    });
    
    weekSelect.onchange = function() {
      currentWeekIndex = parseInt(this.value);
      updateWeeklyDisplay();
    };
  }

  function updateWeeklyDisplay() {
    if (!weeklySummaryData || weeklySummaryData.length === 0) return;
    
    const currentWeek = weeklySummaryData[currentWeekIndex];
    const previousWeek = weeklySummaryData[currentWeekIndex + 1];
    
    document.getElementById('current-week-range').textContent = currentWeek.formattedRange;
    
    document.getElementById('weekly-total-enrage').textContent = `${currentWeek.totalEnrageGained.toLocaleString()}%`;
    document.getElementById('weekly-fastest-time').textContent = formatKillTime(currentWeek.fastestKillTime);
    document.getElementById('weekly-avg-time').textContent = formatKillTime(currentWeek.avgKillTime);
    document.getElementById('weekly-cleanliness').textContent = `${currentWeek.cleanliness.toFixed(1)}%`;
    
    if (previousWeek) {
      const enrageImprovement = calculateImprovementPercentage(currentWeek.totalEnrageGained, previousWeek.totalEnrageGained);
      updateKillTimeImprovementDisplay('weekly-speed-improvement', currentWeek.fastestKillTime, previousWeek.fastestKillTime);
      updateKillTimeImprovementDisplay('weekly-avg-improvement', currentWeek.avgKillTime, previousWeek.avgKillTime);
      updateImprovementDisplay('weekly-enrage-improvement', enrageImprovement);
    } else {
      updateImprovementDisplay('weekly-enrage-improvement', 0);
      document.getElementById('weekly-speed-improvement').textContent = '--';
      document.getElementById('weekly-avg-improvement').textContent = '--';
    }

    updateRadarChart(currentWeek, previousWeek);
  }

  function updateRadarChart(currentWeek, previousWeek) {
    const canvas = document.getElementById('weekly-radar-chart');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    const isDarkMode = isDark();
    
    if (radarChart) radarChart.destroy();
    
    const allPlayerKills = currentKillsForChart || [];
    
    let allEnrageGained = [];
    let allAvgTimes = [];
    let allConsistency = [];
    let allCleanliness = [];
    
    if (weeklySummaryData && weeklySummaryData.length > 0) {
      allEnrageGained = weeklySummaryData.map(w => w.totalEnrageGained);
      allAvgTimes = weeklySummaryData.map(w => w.avgKillTime);
      allConsistency = weeklySummaryData.map(w => w.consistency);
      allCleanliness = weeklySummaryData.map(w => w.cleanliness);
    }
    
    const normalize = (value, values, isLowerBetter = false) => {
      if (values.length === 0 || value === 0) return 0.1;
      
      const min = Math.min(...values);
      const max = Math.max(...values);
      
      if (max === min) return 0.5;
      
      if (isLowerBetter) {
        const normalized = (value - min) / (max - min);
        return Math.max(0.1, 1 - normalized);
      } else {
        return Math.max(0.1, (value - min) / (max - min));
      }
    };
    
    const normalizedData = [
      normalize(currentWeek.totalEnrageGained, allEnrageGained, false),
      normalize(currentWeek.avgKillTime, allAvgTimes, true),
      normalize(currentWeek.consistency, allConsistency, true),
      normalize(currentWeek.cleanliness, allCleanliness, false)
    ];
    
    const datasets = [{
      label: currentWeek.formattedRange,
      data: normalizedData,
      backgroundColor: 'rgba(147, 51, 234, 0.2)',
      borderColor: 'rgb(147, 51, 234)',
      pointBackgroundColor: 'rgb(147, 51, 234)',
      pointBorderColor: '#fff',
      pointHoverBackgroundColor: '#fff',
      pointHoverBorderColor: 'rgb(147, 51, 234)',
      pointHoverRadius: 6,
      borderWidth: 2,
      pointRadius: 4
    }];
    
    if (previousWeek) {
      const previousNormalizedData = [
        normalize(previousWeek.totalEnrageGained, allEnrageGained, false),
        normalize(previousWeek.avgKillTime, allAvgTimes, true),
        normalize(previousWeek.consistency, allConsistency, true),
        normalize(previousWeek.cleanliness, allCleanliness, false)
      ];
      
      datasets.push({
        label: `Previous: ${previousWeek.formattedRange}`,
        data: previousNormalizedData,
        backgroundColor: 'rgba(59, 130, 246, 0.2)',
        borderColor: 'rgb(59, 130, 246)',
        pointBackgroundColor: 'rgb(59, 130, 246)',
        pointBorderColor: '#fff',
        pointHoverBackgroundColor: '#fff',
        pointHoverBorderColor: 'rgb(59, 130, 246)',
        pointHoverRadius: 6,
        borderWidth: 2,
        pointRadius: 4,
        borderDash: [5, 5]
      });
    }
    
    try {
      radarChart = new Chart(ctx, {
        type: 'radar',
        data: {
          labels: ['Total Enrage Gained', 'Kill Time', 'Consistency', 'Cleanliness'],
          datasets: datasets
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            r: {
              beginAtZero: true,
              min: 0,
              max: 1,
              ticks: { display: false, stepSize: 0.2 },
              pointLabels: {
                color: isDarkMode ? '#D1D5DB' : '#374151',
                font: { size: 12, weight: '600' },
                padding: 15
              },
              grid: {
                color: isDarkMode ? 'rgba(75, 85, 99, 0.2)' : 'rgba(156, 163, 175, 0.2)',
                circular: true
              },
              angleLines: {
                color: isDarkMode ? 'rgba(75, 85, 99, 0.2)' : 'rgba(156, 163, 175, 0.2)'
              }
            }
          },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                color: isDarkMode ? '#D1D5DB' : '#374151',
                font: { size: 12 },
                padding: 15,
                usePointStyle: true,
                boxWidth: 10
              }
            },
            tooltip: {
              enabled: true,
              mode: 'nearest',
              intersect: false,
              backgroundColor: isDarkMode ? 'rgba(31, 41, 55, 0.95)' : 'rgba(255, 255, 255, 0.95)',
              titleColor: isDarkMode ? '#F3F4F6' : '#111827',
              bodyColor: isDarkMode ? '#D1D5DB' : '#374151',
              borderColor: isDarkMode ? '#4B5563' : '#E5E7EB',
              borderWidth: 1,
              padding: 12,
              cornerRadius: 8,
              boxPadding: 6,
              displayColors: true,
              callbacks: {
                title: function(tooltipItems) {
                  if (tooltipItems.length > 0) {
                    const datasetIndex = tooltipItems[0].datasetIndex;
                    return datasetIndex === 0 ? 
                      `Current Week: ${currentWeek.formattedRange}` :
                      `Previous Week: ${previousWeek.formattedRange}`;
                  }
                  return '';
                },
                label: function(context) {
                  const label = context.label || '';
                  const value = context.raw;
                  const week = context.datasetIndex === 0 ? currentWeek : previousWeek;
                  
                  if (!week) return '';
                  
                  switch(context.dataIndex) {
                    case 0: return `${label}: ${week.totalEnrageGained.toLocaleString()}% gained`;
                    case 1: return `${label}: ${formatKillTime(week.avgKillTime)} avg`;
                    case 2: return `${label}: ${week.consistency.toFixed(1)}s std dev`;
                    case 3: return `${label}: ${week.cleanliness.toFixed(1)}% near PB`;
                    default: return '';
                  }
                },
                labelColor: function(context) {
                  return {
                    borderColor: context.dataset.borderColor,
                    backgroundColor: context.dataset.borderColor,
                    borderWidth: 2,
                    borderRadius: 2
                  };
                }
              }
            }
          },
          interaction: { intersect: false, mode: 'nearest' },
          elements: {
            line: { tension: 0.1, fill: true },
            point: { hitRadius: 15, hoverRadius: 8 }
          }
        }
      });
    } catch (error) {
      console.error('Radar chart creation failed:', error);
    }
  }

  // ========== UI STATE FUNCTIONS ==========
  function showNoSelectionState() {
    const sectionsToHide = ['stats-cards', 'graph-section', 'kill-table-stats-section', 'weekly-summary-section'];
    sectionsToHide.forEach(id => {
      const element = document.getElementById(id);
      if (element) element.classList.add('hidden');
    });
    
    resetHighestEnrageCard();
    
    const noSelectElement = document.getElementById('no-selection-state');
    if (noSelectElement) noSelectElement.classList.remove('hidden');
  }

  function showPlayerContent() {
    const noSelectElement = document.getElementById('no-selection-state');
    if (noSelectElement) noSelectElement.classList.add('hidden');
    
    const sectionsToShow = ['stats-cards', 'graph-section', 'kill-table-stats-section', 'weekly-summary-section'];
    sectionsToShow.forEach(id => {
      const element = document.getElementById(id);
      if (element) element.classList.remove('hidden');
    });
  }

  // ========== KILL TABLE FUNCTIONS ==========
  function renderKillTable(kills) {
    const tableBody = document.getElementById('kill-table-body');
    const visibleKillsSpan = document.getElementById('visible-kills');
    const tableCountSpan = document.getElementById('table-count');
    
    if (!tableBody || !visibleKillsSpan || !tableCountSpan) return;
    
    const tableKills = [...kills].sort((a, b) => b.timeOfKill - a.timeOfKill);
    
    tableBody.innerHTML = '';
    tableCountSpan.textContent = `${tableKills.length} kills`;
    
    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, tableKills.length);
    const pageKills = tableKills.slice(startIndex, endIndex);
    
    visibleKillsSpan.textContent = `${startIndex + 1}-${endIndex} of ${tableKills.length}`;
    
    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = endIndex >= tableKills.length;
    
    pageKills.forEach((kill, index) => {
      const globalIndex = startIndex + index + 1;
      
      const row = document.createElement('tr');
      row.className = 'hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150';
      
      row.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
          ${globalIndex}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-lg font-bold ${getEnrageColorClass(kill.enrage)}">
            ${kill.enrage.toLocaleString()}%
          </div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-300">
          ${kill.formattedDate}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="font-mono font-semibold text-gray-900 dark:text-white">
            ${kill.formattedKillTime}
          </div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm font-semibold text-blue-600 dark:text-blue-400">
            ${kill.timeAgoDetailed}
          </div>
        </td>
      `;
      
      tableBody.appendChild(row);
    });
    
    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          renderKillTable(kills);
        }
      };
    }
    
    if (nextBtn) {
      nextBtn.onclick = () => {
        if (endIndex < tableKills.length) {
          currentPage++;
          renderKillTable(kills);
        }
      };
    }
  }

  // ========== BRACKET STATS FUNCTIONS ==========
  function renderBracketStats(kills) {
    const container = document.getElementById('bracket-stats-container');
    if (!container) {
      console.error('Bracket stats container not found');
      return;
    }
    
    if (kills.length === 0) {
      container.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No bracket data available</p>';
      return;
    }
    
    const sortedKills = [...kills].sort((a, b) => a.timeOfKill - b.timeOfKill);
    
    const bracketRanges = [
      { min: 55000, max: 59999, label: '55-60k', color: '#8B0000' },
      { min: 50000, max: 54999, label: '50-55k', color: '#B22222' },
      { min: 45000, max: 49999, label: '45-50k', color: '#DC143C' },
      { min: 40000, max: 44999, label: '40-45k', color: '#FF4500' },
      { min: 35000, max: 39999, label: '35-40k', color: '#FF8C00' },
      { min: 30000, max: 35999, label: '30-35k', color: '#FFA500' },
      { min: 25000, max: 29999, label: '25-30k', color: '#FFD700' },
      { min: 20000, max: 24999, label: '20-25k', color: '#9ACD32' },
      { min: 15000, max: 19999, label: '15-20k', color: '#32CD32' },
      { min: 10000, max: 14999, label: '10-15k', color: '#00FA9A' },
      { min: 5000, max: 9999, label: '5-10k', color: '#20B2AA' },
      { min: 0, max: 4999, label: '0-5k', color: '#4682B4' }
    ];
    
    const bracketData = bracketRanges.map(range => {
      const bracketKills = sortedKills.filter(k => k.enrage >= range.min && k.enrage <= range.max);
      
      if (bracketKills.length === 0) return null;
      
      const avgTime = bracketKills.reduce((sum, k) => sum + k.killTimeSeconds, 0) / bracketKills.length;
      const fastest = bracketKills.reduce((fastest, k) => 
        k.killTimeSeconds < fastest.killTimeSeconds ? k : fastest
      );
      
      const firstKill = bracketKills[0];
      const lastKill = bracketKills[bracketKills.length - 1];
      const durationSeconds = lastKill.timeOfKill - firstKill.timeOfKill;
      const durationDays = Math.max(durationSeconds / 86400, 0.1);
      
      const totalEnrageGained = lastKill.enrage - firstKill.enrage;
      let avgEnrageGainedPerDay = 0;
      if (durationDays > 0) {
        avgEnrageGainedPerDay = totalEnrageGained / durationDays;
      } else {
        avgEnrageGainedPerDay = totalEnrageGained;
      }

      let durationFormatted = "0m";
      if (durationSeconds > 0) {
        durationFormatted = formatDuration(durationSeconds);
      } else {
        durationFormatted = "Single kill";
      }
      
      let maxEnrageGainedIn24h = 0;
      let maxEnrageGainedStartTime = 0;
      let maxEnrageGainedEndTime = 0;
      let killsInBest24h = [];
      
      if (bracketKills.length >= 2) {
        bracketKills.sort((a, b) => a.timeOfKill - b.timeOfKill);
        
        for (let i = 0; i < bracketKills.length; i++) {
          const startKill = bracketKills[i];
          const startTime = startKill.timeOfKill;
          const endTime = startTime + 86400;
          
          let j = i;
          let windowKills = [];
          while (j < bracketKills.length && bracketKills[j].timeOfKill <= endTime) {
            windowKills.push(bracketKills[j]);
            j++;
          }
          
          if (windowKills.length >= 2) {
            const sortedWindowKills = [...windowKills].sort((a, b) => a.enrage - b.enrage);
            
            let windowEnrageGain = 0;
            for (let k = 1; k < sortedWindowKills.length; k++) {
              const gain = sortedWindowKills[k].enrage - sortedWindowKills[k-1].enrage;
              if (gain > 0) {
                windowEnrageGain += gain;
              }
            }
            
            const firstInWindow = windowKills[0];
            const lastInWindow = windowKills[windowKills.length - 1];
            const simpleGain = 10 + lastInWindow.enrage - firstInWindow.enrage;

            const windowGain = Math.max(windowEnrageGain, simpleGain);
            
            if (windowGain > maxEnrageGainedIn24h) {
              maxEnrageGainedIn24h = windowGain;
              maxEnrageGainedStartTime = startTime;
              maxEnrageGainedEndTime = endTime;
              killsInBest24h = windowKills;
            }
          }
        }
      }
      
      let formattedMaxEnrageGainPeriod = '--';
      if (maxEnrageGainedStartTime > 0) {
        const startDate = new Date(maxEnrageGainedStartTime * 1000);
        const endDate = new Date(maxEnrageGainedEndTime * 1000);
        
        const startFormatted = startDate.toLocaleDateString('en-US', {
          timeZone: userTimezone,
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
        
        const endFormatted = endDate.toLocaleDateString('en-US', {
          timeZone: userTimezone,
          hour: '2-digit',
          minute: '2-digit'
        });
        
        formattedMaxEnrageGainPeriod = `${startFormatted}`;
      }
      
      const fastestDate = new Date(fastest.timeOfKill * 1000);
      const formattedFastestDate = fastestDate.toLocaleDateString('en-US', {
        timeZone: userTimezone,
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      });
      const formattedFastestTime = fastestDate.toLocaleTimeString('en-US', {
        timeZone: userTimezone,
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
      });
      
      const firstKillDate = new Date(firstKill.timeOfKill * 1000);
      const lastKillDate = new Date(lastKill.timeOfKill * 1000);
      const formattedFirstDate = firstKillDate.toLocaleDateString('en-US', {
        timeZone: userTimezone,
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      });
      const formattedLastDate = lastKillDate.toLocaleDateString('en-US', {
        timeZone: userTimezone,
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      });
      
      const currentMaxEnrage = Math.max(...bracketKills.map(k => k.enrage));
      const bracketRange = range.max - range.min;
      const progressThroughBracket = Math.max(0, currentMaxEnrage - range.min);
      
      let bracketProgress = Math.min((progressThroughBracket / bracketRange) * 100, 100);
      
      if (bracketKills.length > 0 && bracketProgress < 1) {
        bracketProgress = 1;
      }

      let etaToFinish = "N/A";
      if (avgEnrageGainedPerDay > 0) {
        etaToFinish = calculateETA(Math.max(...sortedKills.map(k => k.enrage)), range.min, range.max, avgEnrageGainedPerDay);
      }
      
      return {
        ...range,
        kills: bracketKills.length,
        avgTime: formatKillTime(avgTime),
        fastestTime: formatKillTime(fastest.killTimeSeconds),
        fastestKill: fastest,
        formattedFastestDate: formattedFastestDate,
        formattedFastestTime: formattedFastestTime,
        fastestEnrage: fastest.enrage,
        
        firstKill: firstKill,
        lastKill: lastKill,
        durationSeconds: durationSeconds,
        durationDays: durationDays,
        durationFormatted: durationFormatted,
        totalEnrageGained: totalEnrageGained,
        avgEnrageGainedPerDay: avgEnrageGainedPerDay,
        etaToFinish: etaToFinish,
        
        maxEnrageGainedIn24h: maxEnrageGainedIn24h,
        maxEnrageGainedStartTime: maxEnrageGainedStartTime,
        maxEnrageGainedEndTime: maxEnrageGainedEndTime,
        formattedMaxEnrageGainPeriod: formattedMaxEnrageGainPeriod,
        killsInBest24h: killsInBest24h,
        
        formattedFirstDate: formattedFirstDate,
        formattedLastDate: formattedLastDate,
        
        currentMaxEnrage: currentMaxEnrage,
        
        bracketProgress: bracketProgress
      };
    }).filter(b => b !== null);
    
    if (bracketData.length === 0) {
      container.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No kills in standard brackets</p>';
      return;
    }
    
    container.innerHTML = bracketData.map(bracket => `
      <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
        <!-- Compact Header -->
        <div class="mb-4">
          <div class="flex justify-between items-center mb-3">
            <div>
              <h4 class="font-bold ${getEnrageColorClass(bracket.min)} text-lg inline-block mr-2">
                ${bracket.label}
              </h4>
            </div>
            <span class="px-3 py-1.5 text-sm font-semibold ${getBracketColorClass(bracket.min)} rounded-full">
              ${bracket.kills} kill${bracket.kills !== 1 ? 's' : ''}
            </span>
          </div>
          
          <!-- First/Last Kill Row -->
          <div class="border border-gray-200 dark:border-gray-700 flex items-center justify-between rounded-lg p-3">
            <div class="text-center flex-1">
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">First Kill</p>
              <p class="font-medium ${getEnrageColorClass(bracket.firstKill.enrage)}">
                ${bracket.firstKill.enrage.toLocaleString()}%
              </p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 truncate" title="${bracket.formattedFirstDate}">
                ${bracket.formattedFirstDate}
              </p>
            </div>
            
            <div class="w-px h-8 bg-gray-300 dark:bg-gray-700 mx-2"></div>
            
            <div class="text-center flex-1">
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Last Kill</p>
              <p class="font-medium ${getEnrageColorClass(bracket.lastKill.enrage)}">
                ${bracket.lastKill.enrage.toLocaleString()}%
              </p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 truncate" title="${bracket.formattedLastDate}">
                ${bracket.formattedLastDate}
              </p>
            </div>
          </div>
        </div>
        
        <!-- Stats Grid: 3 columns for top-level metrics -->
        <div class="grid grid-cols-3 gap-3 mb-4">
          <!-- Duration -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3">
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Duration</p>
            <p class="font-bold text-gray-900 dark:text-white text-lg mb-1">
              ${bracket.durationFormatted}
            </p>
          </div>
          
          <!-- Avg Enrage/Day & ETA -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3">
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Avg Enrage/Day</p>
            <p class="font-bold text-gray-900 dark:text-white text-lg mb-1">
              ${bracket.avgEnrageGainedPerDay > 0 ? '+' : ''}${Math.round(bracket.avgEnrageGainedPerDay).toLocaleString()}%
            </p>
            ${bracket.avgEnrageGainedPerDay > 0 && bracket.kills > 1 ? `
              <div class="mt-2 pt-2 border-t border-gray-200 dark:border-gray-700">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">ETA to ${bracket.max === Infinity ? 'next' : bracket.max.toLocaleString() + '%'}</p>
                <p class="text-sm font-semibold text-black dark:text-white">
                  ${bracket.etaToFinish}
                </p>
              </div>
            ` : ''}
          </div>
          
          <!-- Avg Time -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3">
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Avg Kill Time</p>
            <p class="font-bold text-gray-900 dark:text-white text-lg">
              ${bracket.avgTime}
            </p>
          </div>
        </div>
        
        <!-- Secondary Stats: 2 columns for Max Enrage/24h and Fastest Time -->
        <div class="grid grid-cols-2 gap-3 mb-4">
          <!-- Max Enrage Gain in 24h -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3">
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Max Enrage/24h</p>
            <p class="font-bold ${getEnrageColorClass(bracket.min)} text-lg mb-1">
              ${bracket.maxEnrageGainedIn24h > 0 ? '+' : ''}${Math.round(bracket.maxEnrageGainedIn24h).toLocaleString()}%
            </p>
            ${bracket.formattedMaxEnrageGainPeriod !== '--' ? `
              <p class="text-xs text-gray-500 dark:text-gray-400">
                Started on:
              </p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 truncate" title="${bracket.formattedMaxEnrageGainPeriod}">
                ${bracket.formattedMaxEnrageGainPeriod}
              </p>
            ` : `
              <p class="text-xs text-gray-500 dark:text-gray-400">
                Not enough data
              </p>
            `}
          </div>
          
          <!-- Fastest Time -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3">
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Fastest Time</p>
            <p class="font-bold text-gray-900 dark:text-white text-lg mb-1">
              ${bracket.fastestTime}
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              ${bracket.formattedFastestDate}
            </p>
          </div>
        </div>
        
        <!-- Fastest Kill Details (Collapsible) -->
        <details class="group">
          <summary class="flex items-center justify-between text-sm text-gray-600 dark:text-gray-400 cursor-pointer hover:text-gray-900 dark:hover:text-gray-300 py-2 border-t border-gray-200 dark:border-gray-700">
            <span>Fastest Kill Details</span>
            <span class="group-open:rotate-90 transition-transform">▸</span>
          </summary>
          <div class="mt-2 pt-2 space-y-2">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <p class="text-xs text-gray-500 dark:text-gray-400">Date</p>
                <p class="text-sm font-medium text-gray-900 dark:text-white">${bracket.formattedFastestDate}</p>
              </div>
              <div>
                <p class="text-xs text-gray-500 dark:text-gray-400">Time</p>
                <p class="text-sm font-medium text-gray-900 dark:text-white">${bracket.formattedFastestTime}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <p class="text-xs text-gray-500 dark:text-gray-400">Enrage</p>
                <p class="text-sm font-medium ${getEnrageColorClass(bracket.fastestEnrage)}">
                  ${bracket.fastestEnrage.toLocaleString()}%
                </p>
              </div>
              <div>
                <p class="text-xs text-gray-500 dark:text-gray-400">Time Since</p>
                <p class="text-sm font-medium text-blue-600 dark:text-blue-400">
                  ${timeAgoDetailed(bracket.fastestKill.timeOfKill)}
                </p>
              </div>
            </div>
          </div>
        </details>
        
        <!-- Bracket Progress Bar -->
        ${bracket.kills > 1 ? `
          <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Bracket Progress</span>
              <span class="text-sm font-bold ${getEnrageColorClass(bracket.currentMaxEnrage)}">${bracket.bracketProgress.toFixed(0)}%</span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
              <div class="h-2.5 rounded-full ${getBracketProgressColor(bracket.min)} transition-all duration-500" 
                style="width: ${bracket.bracketProgress}%"
                title="Progress from ${bracket.min.toLocaleString()}% to ${bracket.currentMaxEnrage.toLocaleString()}% (max: ${bracket.max === Infinity ? '∞' : bracket.max.toLocaleString() + '%'})"></div>
            </div>
            <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-1">
              <span>${bracket.min.toLocaleString()}%</span>
              <span>Current: ${bracket.currentMaxEnrage.toLocaleString()}%</span>
              <span>${bracket.max === Infinity ? '∞' : bracket.max.toLocaleString() + '%'}</span>
            </div>
          </div>
        ` : `
          <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-2">
              Only ${bracket.kills} kill${bracket.kills !== 1 ? 's' : ''} in this bracket
            </p>
          </div>
        `}
      </div>
    `).join('');
  }
  
  function getBracketColorClass(minEnrage) {
    if (minEnrage >= 55000) return 'bg-[#FFE8E8] dark:bg-[#FF5B5A]/20 text-[#FF5B5A] dark:text-[#FF5B5A] border-[#FF5B5A]/30 dark:border-[#FF5B5A]/30';
    if (minEnrage >= 50000) return 'bg-[#FFE8F0] dark:bg-[#FF6E5F]/20 text-[#F65B7C] dark:text-[#FF6E5F] border-[#F65B7C]/30 dark:border-[#FF6E5F]/30';
    if (minEnrage >= 45000) return 'bg-[#F8E8F3] dark:bg-[#FF8361]/20 text-[#E665A2] dark:text-[#FF8361] border-[#E665A2]/30 dark:border-[#FF8361]/30';
    if (minEnrage >= 40000) return 'bg-[#F0E8F8] dark:bg-[#FF9A62]/20 text-[#D065B8] dark:text-[#FF9A62] border-[#D065B8]/30 dark:border-[#FF9A62]/30';
    if (minEnrage >= 35000) return 'bg-[#ECE8F8] dark:bg-[#FFB369]/20 text-[#B06CBC] dark:text-[#FFB369] border-[#B06CBC]/30 dark:border-[#FFB369]/30';
    if (minEnrage >= 30000) return 'bg-[#E8E8F8] dark:bg-[#FFC870]/20 text-[#8E6CC0] dark:text-[#FFC870] border-[#8E6CC0]/30 dark:border-[#FFC870]/30';
    if (minEnrage >= 25000) return 'bg-[#E8E8F8] dark:bg-[#FFD37E]/20 text-[#766CC0] dark:text-[#FFD37E] border-[#766CC0]/30 dark:border-[#FFD37E]/30';
    if (minEnrage >= 20000) return 'bg-[#E8E8F5] dark:bg-[#FFE396]/20 text-[#6064A7] dark:text-[#FFE396] border-[#6064A7]/30 dark:border-[#FFE396]/30';
    if (minEnrage >= 15000) return 'bg-[#E8EAF5] dark:bg-[#FFECAC]/20 text-[#576190] dark:text-[#FFECAC] border-[#576190]/30 dark:border-[#FFECAC]/30';
    if (minEnrage >= 10000) return 'bg-[#E8EAF2] dark:bg-[#FFF1C1]/20 text-[#535974] dark:text-[#FFF1C1] border-[#535974]/30 dark:border-[#FFF1C1]/30';
    if (minEnrage >= 5000) return 'bg-[#E8E9F2] dark:bg-[#FFF5D1]/20 text-[#474D64] dark:text-[#FFF5D1] border-[#474D64]/30 dark:border-[#FFF5D1]/30';
    return 'bg-[#E8E9F2] dark:bg-[#FFF5D1]/20 text-[#474D64] dark:text-[#FFF5D1] border-[#474D64]/30 dark:border-[#FFF5D1]/30';
  }

  function getBracketProgressColor(minEnrage) {
    if (minEnrage >= 55000) return 'bg-[#FF5B5A] dark:bg-[#FF5B5A]';
    if (minEnrage >= 50000) return 'bg-[#F65B7C] dark:bg-[#FF6E5F]';
    if (minEnrage >= 45000) return 'bg-[#E665A2] dark:bg-[#FF8361]';
    if (minEnrage >= 40000) return 'bg-[#D065B8] dark:bg-[#FF9A62]';
    if (minEnrage >= 35000) return 'bg-[#B06CBC] dark:bg-[#FFB369]';
    if (minEnrage >= 30000) return 'bg-[#8E6CC0] dark:bg-[#FFC870]';
    if (minEnrage >= 25000) return 'bg-[#766CC0] dark:bg-[#FFD37E]';
    if (minEnrage >= 20000) return 'bg-[#6064A7] dark:bg-[#FFE396]';
    if (minEnrage >= 15000) return 'bg-[#576190] dark:bg-[#FFECAC]';
    if (minEnrage >= 10000) return 'bg-[#535974] dark:bg-[#FFF1C1]';
    if (minEnrage >= 5000) return 'bg-[#474D64] dark:bg-[#FFF5D1]';
    return 'bg-[#474D64] dark:bg-[#FFF5D1]';
  }

  // ========== CHART FUNCTIONS ==========
  function setupThemeChangeListener() {
    if (themeChangeObserver) themeChangeObserver.disconnect();
    
    themeChangeObserver = new MutationObserver(() => {
      if (currentKillsForChart && currentPlayer) {
        setTimeout(() => {
          initializeChart(currentKillsForChart);
          if (comparisonKills) initializeDifferenceChart(currentKillsForChart, comparisonKills);
          if (currentKillsForChart.length > 0) {
            const highestEnrageRecord = currentKillsForChart.reduce((prev, current) => 
              (prev.enrage > current.enrage) ? prev : current
            );
            updateHighestEnrageCardColors(highestEnrageRecord.enrage);
          }
          
          if (weeklySummaryData && weeklySummaryData.length > 0) {
            const currentWeek = weeklySummaryData[currentWeekIndex];
            const previousWeek = weeklySummaryData[currentWeekIndex + 1];
            updateRadarChart(currentWeek, previousWeek);
          }
        }, 100);
      }
    });
    
    themeChangeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  }

  function getPointStyle(totalPoints) {
    return {
      pointRadius: 0,
      pointHoverRadius: 2,
      pointBorderWidth: 0,
      borderWidth: 2,
      pointStyle: 'circle',
      showLine: true
    };
  }

  function initializeChart(kills) {
    if (typeof Chart === 'undefined') return;
    
    const canvas = document.getElementById('progress-chart');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    const isDarkMode = isDark();
    
    if (currentChart) currentChart.destroy();
    
    const sortedKills = kills.sort((a, b) => a.timeOfKill - b.timeOfKill);
    const mainStyle = getPointStyle(sortedKills.length);
    
    const mainDataset = {
      label: currentPlayer,
      data: sortedKills.map(kill => ({
        x: kill.timeOfKill * 1000,
        y: kill.enrage
      })),
      borderColor: 'rgb(59, 130, 246)',
      backgroundColor: isDarkMode ? 'rgba(59, 130, 246, 0.1)' : 'rgba(59, 130, 246, 0.1)',
      tension: 0.4,
      pointBackgroundColor: 'rgb(59, 130, 246)',
      pointBorderColor: isDarkMode ? '#0D0D0D' : '#0D0D0D',
      pointBorderWidth: mainStyle.pointBorderWidth,
      borderWidth: mainStyle.borderWidth,
      pointRadius: mainStyle.pointRadius,
      pointHoverRadius: mainStyle.pointHoverRadius,
      pointStyle: mainStyle.pointStyle,
      showLine: mainStyle.showLine
    };
    
    const datasets = [mainDataset];

    if (comparisonPlayer && comparisonKills) {
      const comparisonStyle = getPointStyle(sortedKills.length);
      const comparisonSorted = comparisonKills.sort((a, b) => a.timeOfKill - b.timeOfKill);
      
      const comparisonDataset = {
        label: comparisonPlayer,
        data: comparisonSorted.map(kill => ({
          x: kill.timeOfKill * 1000,
          y: kill.enrage
        })),
        borderColor: 'rgb(16, 185, 129)',
        backgroundColor: isDarkMode ? 'rgba(16, 185, 129, 0.1)' : 'rgba(16, 185, 129, 0.1)',
        tension: 0.4,
        pointBackgroundColor: 'rgb(16, 185, 129)',
        pointBorderColor: isDarkMode ? '#0D0D0D' : '#0D0D0D',
        pointBorderWidth: comparisonStyle.pointBorderWidth,
        borderWidth: comparisonStyle.borderWidth,
        pointRadius: comparisonStyle.pointRadius,
        pointHoverRadius: comparisonStyle.pointHoverRadius,
        pointStyle: comparisonStyle.pointStyle,
        showLine: comparisonStyle.showLine
      };
      
      datasets.push(comparisonDataset);
    }
    
    const timestamps = sortedKills.map(kill => kill.timeOfKill * 1000);
    const minTime = Math.min(...timestamps);
    const maxTime = Math.max(...timestamps);
    const timeRange = maxTime - minTime;
    const daysRange = timeRange / (1000 * 60 * 60 * 24);
    
    let timeUnit = 'day';
    if (daysRange > 365) timeUnit = 'year';
    else if (daysRange > 30) timeUnit = 'month';
    else if (daysRange > 7) timeUnit = 'week';
    else if (daysRange > 2) timeUnit = 'day';
    else if (daysRange > 0.5) timeUnit = 'hour';
    else timeUnit = 'minute';
    
    const textColor = isDarkMode ? '#D1D5DB' : '#374151';
    const gridColor = isDarkMode ? 'rgba(75, 85, 99, 0.2)' : 'rgba(156, 163, 175, 0.2)';
    const titleColor = isDarkMode ? '#C0C0C0' : '#585858';
    
    try {
      currentChart = new Chart(ctx, {
        type: 'line',
        data: { datasets: datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              title: {
                display: true,
                text: 'Enrage %',
                color: titleColor,
                font: { size: 14, weight: 'bold' }
              },
              ticks: {
                color: textColor,
                font: { size: 12 },
                callback: value => value.toLocaleString() + '%',
                padding: 10
              },
              grid: {
                color: gridColor,
                drawBorder: false
              }
            },
            x: {
              type: 'time',
              time: { unit: timeUnit, displayFormats: { day: 'MMM d' } },
              title: {
                display: true,
                text: 'Date',
                color: titleColor,
                font: { size: 14, weight: 'bold' }
              },
              ticks: {
                color: textColor,
                font: { size: 11 },
                maxRotation: 45,
                minRotation: 45,
                padding: 10,
                autoSkip: true,
                maxTicksLimit: Math.min(20, sortedKills.length)
              },
              grid: {
                color: gridColor,
                drawBorder: false
              }
            }
          },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                color: textColor,
                font: {
                  size: sortedKills.length > 1000 ? 12 : 14,
                  weight: '600'
                },
                padding: 20,
                usePointStyle: true,
                pointStyle: 'circle'
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: isDarkMode ? 'rgba(31, 41, 55, 0.9)' : 'rgba(255, 255, 255, 0.9)',
              titleColor: isDarkMode ? '#F3F4F6' : '#111827',
              bodyColor: isDarkMode ? '#D1D5DB' : '#374151',
              borderColor: isDarkMode ? '#4B5563' : '#E5E7EB',
              borderWidth: 1,
              padding: 12,
              cornerRadius: 8,
              callbacks: {
                title: function(tooltipItems) {
                  const index = tooltipItems[0].dataIndex;
                  const kill = sortedKills[index];
                  if (kill) {
                    const date = new Date(kill.timeOfKill * 1000);
                    return date.toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    });
                  }
                  return '';
                },
                label: context => {
                  const label = context.dataset.label || '';
                  const value = context.parsed.y;
                  return `${label}: ${value.toLocaleString()}%`;
                }
              }
            }
          },
          interaction: { intersect: false, mode: 'nearest' },
          elements: {
            line: { fill: false },
            point: {
              hitRadius: sortedKills.length > 500 ? 5 : 10,
              hoverRadius: sortedKills.length > 500 ? 6 : 12
            }
          },
          animation: { duration: sortedKills.length > 1000 ? 0 : 1000 }
        }
      });
      
      if (!themeChangeObserver) setupThemeChangeListener();
      
    } catch (error) {
      console.error('Chart creation failed:', error);
    }
  }

  function interpolateDataPoints(mainKills, comparisonKills) {
    const sortedMain = [...mainKills].sort((a, b) => a.timeOfKill - b.timeOfKill);
    const sortedComp = [...comparisonKills].sort((a, b) => a.timeOfKill - b.timeOfKill);
    
    let mainIdx = 0, compIdx = 0;
    let currentMain = null, currentComp = null;
    const differencePoints = [];
    
    while (mainIdx < sortedMain.length && compIdx < sortedComp.length) {
      const mainTime = sortedMain[mainIdx].timeOfKill;
      const compTime = sortedComp[compIdx].timeOfKill;
      
      if (mainTime <= compTime) {
        currentMain = sortedMain[mainIdx].enrage;
        mainIdx++;
      }
      
      if (compTime <= mainTime) {
        currentComp = sortedComp[compIdx].enrage;
        compIdx++;
      }
      
      if (currentMain !== null && currentComp !== null) {
        differencePoints.push({
          x: Math.min(mainTime, compTime) * 1000,
          y: currentMain - currentComp,
          mainEnrage: currentMain,
          compEnrage: currentComp,
          timeOfKill: Math.min(mainTime, compTime)
        });
      }
    }
    
    return differencePoints;
  }

  function initializeDifferenceChart(mainKills, comparisonKills) {
    if (typeof Chart === 'undefined') {
      console.error('Chart.js not loaded');
      return;
    }
    
    const isDarkMode = isDark();
    const canvas = document.getElementById('difference-chart');
    if (!canvas) {
      console.error('Difference canvas element not found');
      return;
    }
    
    const ctx = canvas.getContext('2d');
    
    if (differenceChart) {
      differenceChart.destroy();
    }
    
    const differenceData = interpolateDataPoints(mainKills, comparisonKills);
    
    if (differenceData.length === 0) {
      console.warn('No valid difference data to display');
      hideDifferenceChart();
      return;
    }
    
    const textColor = isDarkMode ? '#D1D5DB' : '#374151';
    const gridColor = isDarkMode ? 'rgba(75, 85, 99, 0.2)' : 'rgba(156, 163, 175, 0.2)';
    const titleColor = isDarkMode ? '#C0C0C0' : '#585858';
    
    const timestamps = differenceData.map(point => point.x);
    const minTime = Math.min(...timestamps);
    const maxTime = Math.max(...timestamps);
    const timeRange = maxTime - minTime;
    
    let timeUnit = 'day';
    const daysRange = timeRange / (1000 * 60 * 60 * 24);
    
    if (daysRange > 365) {
      timeUnit = 'year';
    } else if (daysRange > 30) {
      timeUnit = 'month';
    } else if (daysRange > 7) {
      timeUnit = 'week';
    } else if (daysRange > 2) {
      timeUnit = 'day';
    } else if (daysRange > 0.5) {
      timeUnit = 'hour';
    } else {
      timeUnit = 'minute';
    }
    
    const diffDataset = {
      label: `Difference (${currentPlayer} - ${comparisonPlayer})`,
      data: differenceData.map(point => ({
        x: point.x,
        y: point.y
      })),
      borderColor: 'rgb(239, 68, 68)',
      backgroundColor: isDarkMode ? 'rgba(239, 68, 68, 0.1)' : 'rgba(239, 68, 68, 0.1)',
      tension: 0.4,
      pointBackgroundColor: function(context) {
        const value = context.raw.y;
        return value >= 0 ? 'rgb(16, 185, 129)' : 'rgb(239, 68, 68)';
      },
      pointBorderColor: isDarkMode ? '#0D0D0D' : '#0D0D0D',
      pointBorderWidth: 0,
      borderWidth: 2,
      pointRadius: 0,
      pointHoverRadius: 2,
      pointStyle: 'circle',
      showLine: true,
      segment: {
        borderColor: function(context) {
          const value = context.p1.parsed.y;
          return value >= 0 ? 'rgb(16, 185, 129)' : 'rgb(239, 68, 68)';
        }
      }
    };
    
    try {
      differenceChart = new Chart(ctx, {
        type: 'line',
        data: { datasets: [diffDataset] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: false,
              title: {
                display: true,
                text: 'Enrage Difference %',
                color: titleColor,
                font: { size: 14, weight: 'bold' }
              },
              ticks: {
                color: textColor,
                font: { size: 12 },
                callback: function(value) {
                  return (value > 0 ? '+' : '') + value.toLocaleString() + '%';
                },
                padding: 10
              },
              grid: {
                color: gridColor,
                drawBorder: false
              }
            },
            x: {
              type: 'time',
              time: {
                unit: timeUnit,
                displayFormats: {
                  millisecond: 'HH:mm:ss.SSS',
                  second: 'HH:mm:ss',
                  minute: 'HH:mm',
                  hour: 'MMM d, HH:mm',
                  day: 'MMM d',
                  week: 'MMM d',
                  month: 'MMM yyyy',
                  year: 'yyyy'
                }
              },
              title: {
                display: true,
                text: 'Date',
                color: titleColor,
                font: { size: 14, weight: 'bold' }
              },
              ticks: {
                color: textColor,
                font: { size: 11 },
                maxRotation: 45,
                minRotation: 45,
                padding: 10,
                autoSkip: true,
                maxTicksLimit: Math.min(20, differenceData.length)
              },
              grid: {
                color: gridColor,
                drawBorder: false
              }
            }
          },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                color: textColor,
                font: {
                  size: differenceData.length > 1000 ? 12 : 14,
                  weight: '600'
                },
                padding: 20,
                usePointStyle: true,
                pointStyle: 'circle'
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: isDarkMode ? 'rgba(31, 41, 55, 0.9)' : 'rgba(255, 255, 255, 0.9)',
              titleColor: isDarkMode ? '#F3F4F6' : '#111827',
              bodyColor: isDarkMode ? '#D1D5DB' : '#374151',
              borderColor: isDarkMode ? '#4B5563' : '#E5E7EB',
              borderWidth: 1,
              padding: 12,
              cornerRadius: 8,
              callbacks: {
                title: function(tooltipItems) {
                  const date = new Date(tooltipItems[0].parsed.x);
                  return date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  });
                },
                label: function(context) {
                  const label = context.dataset.label || '';
                  const value = context.parsed.y;
                  return `${label}: ${value > 0 ? '+' : ''}${value.toLocaleString()}%`;
                },
                afterLabel: function(context) {
                  const value = context.parsed.y;
                  const dataPoint = differenceData[context.dataIndex];
                  if (value > 0) {
                    return `${currentPlayer}: ${dataPoint.mainEnrage.toLocaleString()}%\n${comparisonPlayer}: ${dataPoint.compEnrage.toLocaleString()}%`;
                  } else if (value < 0) {
                    return `${currentPlayer}: ${dataPoint.mainEnrage.toLocaleString()}%\n${comparisonPlayer}: ${dataPoint.compEnrage.toLocaleString()}%`;
                  } else {
                    return `${currentPlayer}: ${dataPoint.mainEnrage.toLocaleString()}%\n${comparisonPlayer}: ${dataPoint.compEnrage.toLocaleString()}%`;
                  }
                }
              }
            }
          },
          interaction: {
            intersect: false,
            mode: 'nearest',
            axis: 'x'
          },
          elements: {
            line: { fill: false },
            point: {
              hitRadius: differenceData.length > 500 ? 5 : 10,
              hoverRadius: differenceData.length > 500 ? 6 : 12
            }
          },
          animation: {
            duration: differenceData.length > 1000 ? 0 : 1000,
          }
        }
      });
      
      updateChartLayout();
      
    } catch (error) {
      console.error('❌ Error creating difference chart:', error);
      hideDifferenceChart();
    }
  }

  function updateChartLayout() {
    const chartsContainer = document.getElementById('charts-container');
    const diffContainer = document.getElementById('difference-chart-container');
    const singleMsg = document.getElementById('single-chart-message');
    
    if (!chartsContainer || !diffContainer) return;
    
    if (showDifferenceMode && comparisonPlayer && comparisonKills) {
      chartsContainer.classList.remove('lg:grid-cols-1');
      chartsContainer.classList.add('lg:grid-cols-2');
      diffContainer.classList.remove('hidden');
      if (singleMsg) singleMsg.classList.add('hidden');
    } else {
      chartsContainer.classList.remove('lg:grid-cols-2');
      chartsContainer.classList.add('lg:grid-cols-1');
      diffContainer.classList.add('hidden');
      if (singleMsg) singleMsg.classList.remove('hidden');
    }
  }

  function hideDifferenceChart() {
    const diffContainer = document.getElementById('difference-chart-container');
    const singleMsg = document.getElementById('single-chart-message');
    
    if (diffContainer) diffContainer.classList.add('hidden');
    if (singleMsg) singleMsg.classList.remove('hidden');
    
    updateChartLayout();
    
    if (differenceChart) {
      differenceChart.destroy();
      differenceChart = null;
    }
  }

  // ========== EVENT HANDLERS ==========
  function handlePlayerSelect(playerName) {
    currentPlayer = playerName;
    currentPage = 1;
    
    if (!playerName) {
      showNoSelectionState();
      return;
    }
    
    const playerRecords = allPlayersData[playerName];
    if (!playerRecords || playerRecords.length === 0) {
      alert('Player data not found');
      return;
    }
    
    const playerKills = processPlayerKills(playerRecords);
    currentKillsForChart = playerKills;
    
    resetHighestEnrageCard();
    processPlayerStats(playerKills, playerName);
    showPlayerContent();
    renderKillTable(playerKills);
    renderBracketStats(playerKills);
    initializeChart(playerKills);
    initializeWeeklySummary(playerKills);
    
    if (comparisonKills) {
      initializeDifferenceChart(playerKills, comparisonKills);
    }
  }

  function handleComparisonSelect(comparePlayerName) {
    comparisonPlayer = comparePlayerName;
    
    if (!comparePlayerName) {
      comparisonKills = null;
      hideDifferenceChart();
      if (currentKillsForChart) initializeChart(currentKillsForChart);
      updateChartLayout();
      return;
    }
    
    const compareRecords = allPlayersData[comparePlayerName];
    if (!compareRecords || compareRecords.length === 0) {
      alert('Comparison player data not found');
      return;
    }
    
    comparisonKills = processPlayerKills(compareRecords);
    
    if (currentKillsForChart) {
      if (showDifferenceMode) {
        initializeChart(currentKillsForChart);
        initializeDifferenceChart(currentKillsForChart, comparisonKills);
      } else {
        initializeChart(currentKillsForChart);
      }
      updateChartLayout();
    }
  }

  // ========== INITIALIZATION ==========
  function initializePage() {
    const urlParams = new URLSearchParams(window.location.search);
    const urlPlayer = urlParams.get('player');

    if (urlPlayer) {
      setTimeout(() => {
        const select = document.getElementById('player-select');
        if (select) {
          select.value = urlPlayer;
          handlePlayerSelect(urlPlayer);
        }
      }, 50);
    }
    showNoSelectionState();
    
    const playerSelect = document.getElementById('player-select');
    if (playerSelect) {
      playerSelect.addEventListener('change', function() {
        const selectedPlayer = this.value;
        handlePlayerSelect(selectedPlayer);
        
        if (selectedPlayer) {
          const newUrl = new URL(window.location);
          newUrl.searchParams.set('player', selectedPlayer);
          window.history.replaceState({}, '', newUrl);
        } else {
          const newUrl = new URL(window.location);
          newUrl.searchParams.delete('player');
          window.history.replaceState({}, '', newUrl);
        }
      });
    }
    
    const compareSelect = document.getElementById('compare-select');
    if (compareSelect) {
      compareSelect.addEventListener('change', function() {
        handleComparisonSelect(this.value);
      });
    }
    
    const showDifferenceCheckbox = document.getElementById('show-difference');
    if (showDifferenceCheckbox) {
      showDifferenceCheckbox.addEventListener('change', function() {
        showDifferenceMode = this.checked;
        
        if (currentKillsForChart && currentPlayer) {
          if (showDifferenceMode && comparisonPlayer && comparisonKills) {
            initializeChart(currentKillsForChart);
            initializeDifferenceChart(currentKillsForChart, comparisonKills);
          } else {
            initializeChart(currentKillsForChart);
            hideDifferenceChart();
          }
          updateChartLayout();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePage);
  } else {
    initializePage();
  }
</script>