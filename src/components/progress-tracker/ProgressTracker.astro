  function calculateETA(currentEnrage, bracketMin, bracketMax, avgEnragePerDay) {
    if (!avgEnragePerDay || avgEnragePerDay <= 0 || currentEnrage > bracketMax) return 'N/A';
    
    const remainingEnrage = bracketMax - currentEnrage;
    const daysRemaining = remainingEnrage / avgEnragePerDay;
    
    if (daysRemaining <= 0) return 'Complete';
    if (daysRemaining < 1) return '<1 day';
    
    const weeks = Math.floor(daysRemaining / 7);
    const remainingDays = Math.ceil(daysRemaining % 7);
    
    if (weeks > 0) {
      return `${weeks} week${weeks !== 1 ? 's' : ''}${remainingDays > 0 ? ` ${remainingDays} day${remainingDays !== 1 ? 's' : ''}` : ''}`;
    } else {
      return `${Math.ceil(daysRemaining)} day${Math.ceil(daysRemaining) !== 1 ? 's' : ''}`;
    }
  }

