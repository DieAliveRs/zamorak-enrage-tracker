---
interface Props {
  latestKills: any[];
  totalKills: number;
}

const { latestKills, totalKills } = Astro.props;

// Server-side helper function
function getRSIconUrl(playerName: string): string | null {
  if (!playerName || playerName === 'Unknown') {
    return null;
  }
  
  const encodedName = encodeURIComponent(playerName);
  return `https://secure.runescape.com/m=avatar-rs/${encodedName}/chat.png`;
}

// Prepare data for client script
const scriptData = {
  latestKills
};
---

<!-- Recent Activity Sidebar -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg dark:shadow-gray-900/30 overflow-hidden h-fit">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-blue-50 to-blue-100 dark:from-blue-900/30 dark:to-blue-800/20">
    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Recent Activity</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">Latest 5 kills recorded</p>
  </div>
  
  {latestKills.length === 0 ? (
    <div class="p-8 text-center">
      <div class="text-gray-300 dark:text-gray-600 text-4xl mb-4">📭</div>
      <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No Recent Activity</h3>
      <p class="text-gray-600 dark:text-gray-400">No kills recorded recently.</p>
    </div>
  ) : (
    <div id="recent-activity-list" class="divide-y divide-gray-200 dark:divide-gray-700">
      {latestKills.map(record => {
        const playerName = record.members[0]?.name || 'Unknown';
        const enragePercent = record.enrage;
        const killTime = record.killTimeSeconds;
        const killDate = record.timeOfKill;
        const avatarUrl = getRSIconUrl(playerName);
        
        // Format kill time
        const killTimeFormatted = (() => {
          const mins = Math.floor(killTime / 60);
          const secs = (killTime % 60).toFixed(1);
          return `${mins}:${secs.padStart(4, '0')}`;
        })();
        
        return (
          <div class="p-5 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150">
            <div class="flex-1">
              <div class="flex justify-between items-start">
                <div class="flex items-start space-x-3">
                  {avatarUrl ? (
                    <img src={avatarUrl} alt={playerName}
                         class="w-10 h-10 rounded-full border border-gray-300 dark:border-gray-600 flex-shrink-0 mt-1" />
                  ) : (
                    <div class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 
                                flex items-center justify-center text-gray-500 dark:text-gray-400
                                flex-shrink-0 mt-1">
                      👤
                    </div>
                  )}
                  <div>
                    <a 
                      href={`/personal-progress/?player=${encodeURIComponent(playerName)}`}
                      class="font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 truncate max-w-[180px] transition-colors duration-150 hover:underline"
                      title={`View ${encodeURIComponent(playerName)}'s detailed stats`}
                    >
                      {playerName}
                    </a>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-timestamp={killDate}>
                      <!-- Will be formatted by JavaScript -->
                    </p>
                  </div>
                </div>
                <span class="text-sm font-bold text-gray-900 dark:text-white">
                  {enragePercent.toLocaleString()}%
                </span>
              </div>
              
              <div class="mt-3 flex items-center justify-between">
                <div class="flex items-center space-x-4">
                  <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                    <span class="mr-1">⏱️</span>
                    <span class="font-mono font-semibold">{killTimeFormatted}</span>
                  </div>
                </div>
                <div class="text-sm font-semibold text-blue-600 dark:text-blue-400" data-timestamp={killDate}>
                  <!-- Will show time ago by JavaScript -->
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
  
  <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
    <div class="text-sm text-gray-600 dark:text-gray-400">
      <span>{latestKills.length}</span> of <span>{totalKills}</span> total kills shown
    </div>
  </div>
</div>

<script define:vars={{ scriptData }}>
  // Helper functions
  function formatTimestamp(timestamp) {
    const date = new Date(timestamp * 1000);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }
  
  function timeAgo(timestamp) {
    const now = Math.floor(Date.now() / 1000);
    const secondsAgo = now - timestamp;
    
    if (secondsAgo < 60) return 'Just now';
    
    const hours = Math.floor(secondsAgo / 3600);
    const minutes = Math.floor((secondsAgo % 3600) / 60);
    
    if (hours > 0) {
      if (hours >= 72) {
        const days = Math.floor(hours / 24);
        return `${days}d ago`;
      }
      return `${hours}h ${minutes}m ago`;
    }
    return `${minutes}m ago`;
  }

  function formatRecentActivityTimes() {
    // Format date cells in recent activity
    document.querySelectorAll('#recent-activity-list [data-timestamp]').forEach(element => {
      const timestamp = parseInt(element.getAttribute('data-timestamp'));
      if (isNaN(timestamp)) return;
      
      if (element.classList.contains('text-xs')) {
        // Date text
        if (!element.classList.contains('formatted')) {
          element.textContent = formatTimestamp(timestamp);
          element.classList.add('formatted');
        }
      } else if (element.classList.contains('text-blue-600') || element.classList.contains('dark:text-blue-400')) {
        // Time ago text
        if (!element.classList.contains('formatted')) {
          element.textContent = timeAgo(timestamp);
          element.classList.add('formatted');
        }
      }
    });
  }
  
  // Update time ago every minute
  function updateTimeAgo() {
    document.querySelectorAll('#recent-activity-list .text-blue-600.dark\\:text-blue-400[data-timestamp]').forEach(el => {
      if (el.classList.contains('formatted')) {
        const timestamp = parseInt(el.getAttribute('data-timestamp'));
        el.textContent = timeAgo(timestamp);
      }
    });
  }
  
  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      formatRecentActivityTimes();
      setInterval(updateTimeAgo, 60000);
    });
  } else {
    formatRecentActivityTimes();
    setInterval(updateTimeAgo, 60000);
  }
</script>