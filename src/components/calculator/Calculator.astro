---
// src/components/calculator/Calculator.astro

import SettingsTabs from './settings/SettingsTabs.astro';
import ReflectSettings from './settings/ReflectSettings.astro';
import PadEffects from './panels/PadEffects.astro';
import ResultsDisplay from './panels/ResultsDisplay.astro';
---

<title>Zamorak Calculator</title>
<div class="w-full px-4 py-4">
    <!-- Header -->
    <header class="mb-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <!-- <img src="/images/icons/zam.png" alt="Zamorak" class="w-12 h-12 object-contain" /> -->
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Zamorak Calculator</h1>
                    <p class="text-gray-600 dark:text-gray-400">Calculate damage taken from Zamorak</p>
                </div>
            </div>
            
            <!-- Controls -->
            <!-- <div class="flex space-x-2">
                <button
                    id="reset-btn"
                    class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors"
                >
                    Reset
                </button>
                
                <label class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors cursor-pointer">
                    Import
                    <input type="file" id="import-file" accept=".json" class="hidden" />
                </label>
                
                <button
                    id="export-btn"
                    class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors"
                >
                    Export
                </button>
            </div> -->
        </div>
    </header>
    
    <!-- Main Calculator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Left Column: Settings -->
        <div class="lg:col-span-1 space-y-4">
            <SettingsTabs />
            <ReflectSettings />
        </div>
        
        <!-- Middle Column: Pad Effects & HP -->
        <div class="lg:col-span-1">
            <PadEffects />
        </div>
        
        <!-- Right Column: Results -->
        <div class="lg:col-span-1">
            <ResultsDisplay />
        </div>
    </div>
    
    <!-- Footer -->
    <!-- <footer class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
        <div class="text-center text-gray-600 dark:text-gray-400 text-sm">
            <p>Zamorak Calculator v2.0 • Based on Python calculator by original author</p>
        </div>
    </footer> -->
</div>

<!-- Main Calculator Script -->
<script type="module" src="/src/components/calculator/client/calculatorClient.js"></script>