  function formatDuration(seconds) {
    if (seconds < 60) return "<1m";
    
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    
    if (days > 0) {
      if (hours > 0 && days < 3) return `${days}d ${hours}h`;
      return `${days}d`;
    }
    if (hours > 0) {
      if (minutes > 0 && hours < 6) return `${hours}h ${minutes}m`;
      return `${hours}h`;
    }
    return `${minutes}m`;
  }

  // ========== WEEKLY SUMMARY UTILITIES ==========
  function getWeekNumber(date) {
    const d = new Date(date);
    d.setHours(0, 0, 0, 0);
    d.setDate(d.getDate() + 4 - (d.getDay() || 7));
    const yearStart = new Date(d.getFullYear(), 0, 1);
    const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
    return weekNo;
  }

  function getWeekStartDate(date) {
    const d = new Date(date);
    const day = d.getDay();
    const diff = d.getDate() - day + (day === 0 ? -6 : 1);
    return new Date(d.setDate(diff));
  }

  function formatWeekRange(start, end) {
    return `${start.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} - ${end.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;
  }

  function calculateWeeklyStats(kills) {
    if (kills.length === 0) return null;
    
    const sortedKills = [...kills].sort((a, b) => a.timeOfKill - b.timeOfKill);
    const weeks = new Map();
    
    sortedKills.forEach(kill => {
      const date = new Date(kill.timeOfKill * 1000);
      const weekNumber = getISOWeek(date);
      const year = date.getFullYear();
      const weekKey = `${year}-W${weekNumber.toString().padStart(2, '0')}`;
      
      if (!weeks.has(weekKey)) {
        const weekStart = getISOWeekStart(date);
        weeks.set(weekKey, {
          start: weekStart,
          end: new Date(weekStart.getTime() + 6 * 24 * 60 * 60 * 1000),
          kills: [],
          killTimes: []
        });
      }
      
      const week = weeks.get(weekKey);
      week.kills.push(kill);
      week.killTimes.push(kill.killTimeSeconds);
    });
    
    const weeklyStats = Array.from(weeks.entries())
      .sort(([keyA], [keyB]) => keyB.localeCompare(keyA))
      .map(([weekKey, week]) => {
        const sortedWeekKills = week.kills.sort((a, b) => a.timeOfKill - b.timeOfKill);
        
        let totalEnrageGained = 0;
        if (sortedWeekKills.length === 1) {
          totalEnrageGained = 10;
        } else if (sortedWeekKills.length > 1) {
          totalEnrageGained = 10;
          for (let i = 1; i < sortedWeekKills.length; i++) {
            const currentEnrage = sortedWeekKills[i].enrage;
            const previousEnrage = sortedWeekKills[i-1].enrage;
            totalEnrageGained += (currentEnrage - previousEnrage);
          }
        }
        
        const fastestKill = sortedWeekKills.reduce((fastest, current) => 
          current.killTimeSeconds < fastest.killTimeSeconds ? current : fastest
        );
        
        const avgKillTime = week.killTimes.length > 0 
          ? week.killTimes.reduce((sum, time) => sum + time, 0) / week.killTimes.length
          : 0;
        
        let stdDev = 0;
        if (week.killTimes.length > 1) {
          const variance = week.killTimes.reduce((sum, time) => 
            sum + Math.pow(time - avgKillTime, 2), 0) / week.killTimes.length;
          stdDev = Math.sqrt(variance);
        }
        
        let cleanliness = 0;
        if (week.killTimes.length > 0) {
          const personalBest = Math.min(...week.killTimes);
          const nearPersonalBest = week.killTimes.filter(time => time <= personalBest * 1.1).length;
          cleanliness = (nearPersonalBest / week.killTimes.length) * 100;
        }
        
        return {
          weekKey,
          startDate: week.start,
          endDate: week.end,
          formattedRange: formatWeekRange(week.start, week.end),
          kills: sortedWeekKills,
          totalEnrageGained,
          fastestKillTime: fastestKill.killTimeSeconds,
          avgKillTime,
          consistency: stdDev,
          cleanliness,
          killCount: sortedWeekKills.length,
          maxEnrage: Math.max(...sortedWeekKills.map(k => k.enrage)),
          minEnrage: Math.min(...sortedWeekKills.map(k => k.enrage)),
          enrageRange: sortedWeekKills.length > 0 ? 
            `${sortedWeekKills[0].enrage} - ${sortedWeekKills[sortedWeekKills.length - 1].enrage}` : '--'
        };
      })
      .filter(week => week.killCount > 0);
    
    return weeklyStats;
  }

  function getISOWeek(date) {
    const target = new Date(date.valueOf());
    const dayNr = (date.getDay() + 6) % 7;
    target.setDate(target.getDate() - dayNr + 3);
    const firstThursday = target.valueOf();
    target.setMonth(0, 1);
    if (target.getDay() !== 4) {
      target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7);
    }
    return 1 + Math.ceil((firstThursday - target) / 604800000);
  }

  function getISOWeekStart(date) {
    const d = new Date(date);
    const day = d.getDay();
    const diff = d.getDate() - day + (day === 0 ? -6 : 1);
    return new Date(d.setDate(diff));
  }

  function calculateImprovementPercentage(current, previous, isTime = false) {
    if (!previous || previous === 0) return 0;
    
    if (isTime) {
      return ((previous - current) / previous) * 100;
    } else {
      return ((current - previous) / previous) * 100;
    }
  }

  function updateImprovementDisplay(elementId, value, isPositive = true) {
    const element = document.getElementById(elementId);
    if (!element) return;
    
    const arrow = document.getElementById(elementId.replace('-improvement', '-arrow'));
    
    if (value === 0) {
      element.textContent = '0%';
      element.className = 'text-sm font-semibold text-gray-600 dark:text-gray-400 mr-1';
      if (arrow) arrow.textContent = '→';
    } else if ((isPositive && value > 0) || (!isPositive && value < 0)) {
      element.textContent = `+${Math.abs(value).toFixed(1)}%`;
      element.className = 'text-sm font-semibold text-green-600 dark:text-green-400 mr-1';
      if (arrow) arrow.textContent = '↗';
      if (arrow) arrow.className = 'text-sm text-green-600 dark:text-green-400';
    } else {
      element.textContent = `-${Math.abs(value).toFixed(1)}%`;
      element.className = 'text-sm font-semibold text-red-600 dark:text-red-400 mr-1';
      if (arrow) arrow.textContent = '↘';
      if (arrow) arrow.className = 'text-sm text-red-600 dark:text-red-400';
    }
  }

  function updateKillTimeImprovementDisplay(elementId, currentTime, previousTime) {
    const element = document.getElementById(elementId);
    if (!element) return;
    
    const arrow = document.getElementById(elementId.replace('-improvement', '-arrow'));
    
    if (!previousTime || previousTime === 0) {
      element.textContent = '--';
      element.className = 'text-sm font-semibold text-gray-600 dark:text-gray-400 mr-1';
      if (arrow) arrow.textContent = '→';
      return;
    }
    
    const improvement = ((previousTime - currentTime) / previousTime) * 100;
    
    if (improvement === 0) {
      element.textContent = '0%';
      element.className = 'text-sm font-semibold text-gray-600 dark:text-gray-400 mr-1';
      if (arrow) arrow.textContent = '→';
    } else if (improvement > 0) {
      element.textContent = `-${Math.abs(improvement).toFixed(1)}%`;
      element.className = 'text-sm font-semibold text-green-600 dark:text-green-400 mr-1';
      if (arrow) arrow.textContent = '↘';
      if (arrow) arrow.className = 'text-sm text-green-600 dark:text-green-400';
    } else {
      element.textContent = `+${Math.abs(improvement).toFixed(1)}%`;
      element.className = 'text-sm font-semibold text-red-600 dark:text-red-400 mr-1';
      if (arrow) arrow.textContent = '↗';
      if (arrow) arrow.className = 'text-sm text-red-600 dark:text-red-400';
    }
  }

